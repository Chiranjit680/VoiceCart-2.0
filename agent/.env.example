# OpenAI-compatible inference endpoint that drives every agent
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
INFERENCE_MODEL=
# MCP server started with MCP_TRANSPORT=streamable-http
MCP_SERVER_URL=http://127.0.0.1:8004/mcp
# Product Service (checks that a session belongs to the caller, stores the transcript)
PRODUCT_SERVICE_URL=http://localhost:8000
# Postgres for the conversation store. Optional: defaults to `database_url` from the root .env
# AGENT_DATABASE_URL=postgresql://user:password@localhost:5432/dbname
